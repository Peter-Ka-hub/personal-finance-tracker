# Shared database credentials (Azure PostgreSQL)
DB_HOST=postgresql-for-project.postgres.database.azure.com
DB_PORT=5432
DB_USER=login
DB_PASSWORD=your_password
DB_NAME=postgres

# JWT secret — must be identical across all services
JWT_SECRET=your_jwt_secret_min_32_chars

# Internal service-to-service API key (auth → categories seed)
INTERNAL_API_KEY=your_internal_api_key_min_32_chars

# Frontend API URL (used by React app in local dev)
REACT_APP_API_URL=http://localhost/api
