# ── Local Docker Compose (default) ──────────────────────────────────────────
# DB_HOST must be "postgres" (the docker-compose service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER=financeuser
DB_PASSWORD=your_db_password
DB_NAME=financedb
DB_SSL=false

# ── Azure PostgreSQL (production) ─────────────────────────────────────────────
# DB_HOST=your-server.postgres.database.azure.com
# DB_SSL=true

# JWT secret — must be identical across all services (min 32 chars)
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Internal service-to-service API key (auth → categories seed)
INTERNAL_API_KEY=your_internal_api_key_min_32_chars

# Frontend API URL (used by React app in local dev outside Docker)
REACT_APP_API_URL=http://localhost/api

# Optional: restrict CORS to specific origins (comma-separated). Unset = allow all.
# Not needed when the frontend is served behind the gateway (same origin, /api).
# CORS_ORIGIN=https://example.com
